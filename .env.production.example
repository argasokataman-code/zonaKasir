# zonaKasir On-Prem production template.
# Copy to .env on the customer server and fill values.
# NEVER commit the real .env. Never include ONPREM_PRIVATE_KEY here.

APP_NAME=zonaKasir
# IMPORTANT: on-prem must run as production
APP_ENV=production
APP_LOCAL=id
APP_KEY=base64:CHANGE_ME_RUN_php_artisan_key_generate
# ALWAYS false in production — true leaks stack traces & env to anyone
APP_DEBUG=false
# Set to the real URL the customer opens (http://IP or https://domain)
APP_URL=http://localhost:8081

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=zonakasir
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
UPLOAD_DISK=public
TMP_DISK=tmp
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# false when serving over plain http://IP (cookie would never be sent).
# true ONLY when customer has valid HTTPS.
SESSION_SECURE_COOKIE=false

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

SELLING_METHOD=normal
SPA_MODE=false
DARK_MODE=false

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false

# --- On-Prem ---
ONPREM_MODE=true
# License key generated by vendor: php artisan onprem:license
ONPREM_LICENSE_KEY=CHANGE_ME
# Vendor public key (base64: prefix). NEVER the private key.
ONPREM_PUBLIC_KEY=CHANGE_ME

# Heartbeat (optional monitoring). Leave empty to disable — kasir keeps working.
ONPREM_HEARTBEAT_URL=
ONPREM_HEARTBEAT_TOKEN=
ONPREM_INSTANCE_ID=

DEBUGBAR_ENABLED=false
